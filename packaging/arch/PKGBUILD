# Maintainer: André Borba
pkgname=borbatop
pkgver=2
pkgrel=1
pkgdesc='Native Linux task manager for the terminal, made for Arch'
arch=('x86_64' 'aarch64')
url='https://github.com/AF2B/borbatop'
license=('MIT' 'Apache-2.0')
depends=('gcc-libs' 'glibc')
makedepends=('cargo')
optdepends=('systemd: Services, Boot and Logs tabs'
            'pacman: Pacman tab and package names'
            'nvidia-utils: NVIDIA readings in the GPU tab'
            'podman: Containers tab'
            'docker: Containers tab'
            'yay: AUR upgrades in the Pacman tab'
            'paru: AUR upgrades in the Pacman tab')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP') # replace with the release tarball checksum

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --all-features
  for shell in bash zsh fish; do
    target/release/borbatop completions "$shell" > "borbatop.$shell"
  done
  target/release/borbatop man > borbatop.1
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  # Only the pure crate: the others read /proc, systemd and pacman of the build host.
  cargo test --frozen -p borbatop-core
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/borbatop "$pkgdir/usr/bin/borbatop"
  install -Dm644 borbatop.1 "$pkgdir/usr/share/man/man1/borbatop.1"
  install -Dm644 borbatop.bash "$pkgdir/usr/share/bash-completion/completions/borbatop"
  install -Dm644 borbatop.zsh "$pkgdir/usr/share/zsh/site-functions/_borbatop"
  install -Dm644 borbatop.fish "$pkgdir/usr/share/fish/vendor_completions.d/borbatop.fish"
  install -Dm644 packaging/config.example.toml "$pkgdir/usr/share/doc/$pkgname/config.example.toml"
  install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
}
